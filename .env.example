# ============================================================
# 复制为 .env 后按需修改；本文件会被提交，真正的 .env 不会。
# 全部变量都有默认值，不配置也能直接 npm start。
# ============================================================

# ---- 服务 ----
# 监听端口（容器内需与端口映射一致）
PORT=3000
# 设为 production 时 express 会启用视图缓存等优化
NODE_ENV=production

# ---- 代理行为 ----
# 是否允许代理本机 / 内网地址。默认 false：这是 SSRF 防护的一部分。
# 仅在本地跑回归测试（夹具服务在 127.0.0.1）时才需要设为 true，切勿在线上开启。
ALLOW_LOCALHOST=false
# 是否严格校验目标站 TLS 证书（含 WebSocket 隧道）。默认 false：代理要够到自签/过期站点。
# 设为 true 开启严格校验（代价是异常证书站点会被挡掉，且不再容忍中间人）。详见 SECURITY.md。
PROXY_REJECT_UNAUTHORIZED=false

# 单请求代理总超时。必须大于 CONNECT_TIMEOUT_MS × (PROXY_RETRY + 1)，
# 否则整体计时器会先掐断重试，调大连接超时就完全不起作用了。
PROXY_TIMEOUT_MS=70000
# 与目标站建连超时
CONNECT_TIMEOUT_MS=30000
# 连接层失败的重试次数（整体超时不重试，避免用户干等双倍时长）
PROXY_RETRY=1
# WebSocket 隧道建连超时
WS_CONNECT_TIMEOUT_MS=15000

# ---- DNS 解析 ----
# auto（默认）：fake-ip 直通 → DoH → 系统解析；system：只用系统解析；doh：强制 DoH
# 注意不要无条件用 doh：本机跑 fake-ip 代理时，真实 IP 会绕过代理，反而更慢。
PROXY_DNS_MODE=auto
# DNS 缓存时长（毫秒）
DNS_CACHE_TTL_MS=60000
# DoH 查询超时
DOH_TIMEOUT_MS=2000
# 建连前的 TCP 探测超时
DNS_PROBE_TIMEOUT_MS=400

# ---- 出口代理（可选）----
# 若部署环境需要经上游代理访问外网，在此指定。留空表示直连。
# 注意：目标站被判定为内网地址的请求不会回退到这里重试（否则 SSRF 防护可被绕过）。
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# ---- 调试 ----
# 打印 LLM 转发日志
DEBUG_LLM=
# 打印代理细节
DEBUG_PROXY=
